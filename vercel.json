{
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/p?id=:id"
    }
  ],
  "redirects": [
    {
      "source": "/v3",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v3/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v3/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/v2",
      "destination": "/v2/",
      "permanent": false
    }
  ]
}
